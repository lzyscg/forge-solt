# Forge Core vNext —— 全局环境配置
#
# 复制为 .env 后填写。`.env` 已被 .gitignore 排除，不会进版本控制。
#
#   cp .env.example .env
#
# 这是**唯一**需要你手工编辑的运行时配置文件。
# `npm run dev` / `dev:server` / `dev:fake` / `migrate` 都会自动加载它
# （脚本里的 --env-file-if-exists=.env）。没有 .env 时不会报错，全部走默认值。
#
# 解析与校验在 src/server/config/env.ts，是全系统唯一读 process.env 做配置的地方。
# 值非法会**在启动时就拒绝**并指名是哪一项，不会静默退回默认值。
# 留空 = 使用默认值（空串按「未设置」处理）。
#
# ---------------------------------------------------------------------------
# 与 config/providers.yaml 的分工
# ---------------------------------------------------------------------------
# 本文件放**值**（会变、含机密、不进 git）；
# providers.yaml 放**结构**（provider 列表、baseUrl、模型、别名、超时，进 git 可评审）。
#
# 安全约束（REQ §13）：API Key 只允许从环境变量注入。
# providers.yaml 只记录变量【名】（apiKeyEnv），绝不记录值——
# 它的 schema 是 .strict()，写一个 apiKey: 字段会当场报错。
# 换 Key = 只改本文件一行；加一个新 Provider = providers.yaml 加一块 + 本文件加一行。

# ===== Provider 凭据 =====
# 变量名必须与 config/providers.yaml 里的 apiKeyEnv 对应。
# 缺失不会阻止服务启动（可以照常浏览历史任务），但启动时会打警告，
# Provider 设置页显示 down，且任何生产都会失败。
DEEPSEEK_API_KEY=

# OpenCode Zen（聚合网关，D-17 补正）。可选：不填则该 Provider 显示 down，
# 其余功能不受影响——当前 aliases 仍指向 DeepSeek 官方。
OPENCODE_API_KEY=

# 火山方舟 Coding Plan（订阅制套餐）。可选，同上：不填只让该 Provider 显示 down。
# 注意 config/providers.yaml 里的 baseUrl 必须是 /api/coding/v3——写成 /api/v3
# 不会报错，但会绕过套餐额度按量计费。别改那一行。
ARK_API_KEY=

# ===== 服务 =====
# PORT     监听端口，默认 3311（前端 vite dev 的代理目标写死指向它）
# HOST     监听地址，默认 127.0.0.1（只监听本机；要局域网访问改 0.0.0.0）
PORT=3311
HOST=127.0.0.1
NODE_ENV=development

# ===== 存储 =====
# 数据全部落在这一个 SQLite 文件里：任务、槽位正文、执行、轨迹、产物、冻结快照。
# 切换它就等于切换整个历史记录——同一个路径启动才看得到之前的运行记录。
# 默认 ./data/forge-core.sqlite
#
# ⚠️ data/ 下的 .sqlite 全部被 gitignore，**没有备份**，删了就没了。
#    m4-*.sqlite 与 m7-*.sqlite 是调优报告与验收的原始数据，别删。
#    npm run dev:fake 默认落到 ./data/dev-fake.sqlite（不污染真实生产库），
#    但你在这里显式设了值的话，以你的为准。
DATABASE_PATH=./data/forge-core.sqlite

# ===== 模板与 Skill 根目录 =====
# 磁盘上的可编辑输入。注意任务一旦创建就**冻结快照**，
# 之后改这两个目录不会影响已存在的任务（AC-002）。
TEMPLATES_DIR=./templates
SKILLS_DIR=./skills

# ===== 日志 =====
# fatal | error | warn | info | debug | trace | silent
# 拼错会在启动时报错，而不是静默退回 info。
LOG_LEVEL=info

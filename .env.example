# Forge Core vNext — 环境变量样例
# 复制为 .env 后填入真实值。.env 已被 .gitignore 排除。
#
# 安全约束（REQ §13）：API Key 只允许从环境变量注入。
# 严禁写入 Template / Snapshot / Slot / Execution / Artifact / Trace / Prompt /
# Tool Result / API Response 中的任何位置。
# config/providers.yaml 只记录变量名（apiKeyEnv），不记录值。

# ---- Provider 凭据 ----
# DeepSeek（P0 唯一必需，D-17）
DEEPSEEK_API_KEY=

# ---- 服务 ----
PORT=3311
NODE_ENV=development

# ---- 存储 ----
DATABASE_PATH=./data/forge-core.sqlite

# ---- 模板与 Skill 根目录 ----
TEMPLATES_DIR=./templates
SKILLS_DIR=./skills

# ---- 日志 ----
LOG_LEVEL=info
